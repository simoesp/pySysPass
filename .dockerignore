# Deny by default; the Dockerfile copies an explicit allowlist. Anything not
# re-included here (including .env*, data/, backups/, and runtime config) never
# reaches the build context.
*

!requirements.lock
!alembic.ini
!init_db.py
!alembic/
!schemas/
!app/
!config/cors-origins.json

# Never ship caches or secrets that might sit inside allowed directories.
**/__pycache__
**/*.py[co]
**/.env*
**/*.pem
**/*.key
