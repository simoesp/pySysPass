# Existing MySQL/MariaDB sysPass database. URL-encode special characters in
# credentials before placing them in this SQLAlchemy URL.
#
# PREFIX MAPPING (per ADR-0017 V-01):
# - Variables here use the PYSYSPASS_ prefix
# - pydantic Settings class uses bare names (e.g., SECRET_KEY, not PYSYSPASS_SECRET_KEY)
# - Docker Compose maps ${PYSYSPASS_...} → bare names inside the container
# - For local .env development, use bare names directly (no PYSYSPASS_ prefix)
PYSYSPASS_DATABASE_URL=mysql+pymysql://user:***@database.example:3306/syspass

# Generate independent values with: openssl rand -hex 32
#
# PREFIX MAPPING (per ADR-0017 V-01):
# - Variables here use the PYSYSPASS_ prefix
# - pydantic Settings class uses bare names (e.g., SECRET_KEY, not PYSYSPASS_SECRET_KEY)
# - Docker Compose maps ${PYSYSPASS_...} → bare names inside the container
# - For local .env development, use bare names directly (no PYSYSPASS_ prefix)
PYSYSPASS_SECRET_KEY=replace-with-a-random-signing-secret
PYSYSPASS_ENCRYPTION_KEY=replace-with-a-random-encryption-key

# Copy passwordSalt from the PHP installation's app/config/config.xml.
#
# PREFIX MAPPING (per ADR-0017 V-01):
# - Variables here use the SYSPASS_ prefix (no PYSYSPASS_ because this
#   setting predates the PYSYSPASS_ convention and maps directly to the
#   PHP config parameter name)
# - pydantic Settings uses the bare name SYSPASS_PASSWORD_SALT
# - Docker Compose references SYSPASS_PASSWORD_SALT directly
SYSPASS_PASSWORD_SALT=replace-with-the-php-password-salt

# Frontend host port. The backend is private to the compose network.
#
# PREFIX MAPPING (per ADR-0017 V-01):
# - PYSYSPASS_FRONTEND_PORT maps to the compose-injected bare name
# - Settings expects the bare name (no prefix)
# - For local .env: use SYSPASS_FRONTEND_PORT or bare name directly
PYSYSPASS_FRONTEND_PORT=8081

# Debug mode. Controls app startup behavior.
#
# PREFIX MAPPING (per ADR-0017 V-01):
# - PYSYSPASS_DEBUG is the env var name used in .env.external.example
# - Settings model expects DEBUG (bare name)
# - Docker Compose injects via ${PYSYSPASS_DEBUG:-false}
# - For local .env: use DEBUG=true/false directly
PYSYSPASS_DEBUG=false